# Copy to nucleus.toml. This file contains ONLY non-identifying tunables —
# anything that uniquely identifies a user, channel, account, or path lives
# in `.env` (gitignored). See `.env.example`.

[claude]
binary = "claude"
# auto = per-call classifier (recommended). Other choices:
# default, acceptEdits, plan, dontAsk, bypassPermissions
permission_mode = "auto"
disallowed_tools = [
  "Bash(rm *)",
  "Bash(sudo *)",
  "Bash(diskutil *)",
  "Bash(dd *)",
  "Bash(shutdown *)",
  "Bash(reboot *)",
  "Bash(launchctl *)",
  # claude-in-chrome pops an interactive "install extension?" dialog — in a
  # headless bot/fire session that wedges the session forever (2026-07-18,
  # WhatsApp bot stuck on it after ML blocked its fetches).
  "Skill(claude-in-chrome)",
]

[discord]
# How the Discord bot decides whether to respond.
mention_only_in_channels = true
dms_always_respond = true

[obsidian]
# Path to your Obsidian vault. Tilde-expanded at load.
vault_path = "~/Documents/Obsidian"

[news]
# Informational — the real schedule is the plist's StartCalendarInterval
# (09:00 + 19:00 local, ADR-031).
fetch_cron = "0 9,19 * * *"
# Vault-relative prose profile of the reader. This note IS the ranking rubric
# (ADR-031): the operator writes it, the fetcher only reads it, and a run
# without it fails rather than guessing.
profile_note = "4-Areas/Nucleus/news-profile.md"
# Relevance floor for what reaches the widget. Not a count cap.
min_score = 0.35
# Where the notch widget reads its feeds. The fetcher writes news.json here
# and drains news-votes.json back out of it.
widget_feed_dir = "~/Library/Application Support/NotchWidget"
# Case-insensitive regex; a title/summary match drops the item before ranking.
exclude_title_regex = ""

[diary]
root = "memory/diaries"
retain_days = 7

[distiller]
# ADR-016: one consolidated daily pass (extract → judge → archive → prune),
# replacing the old hourly-metabolism + weekly-contemplation split. The real
# schedule lives in tools/launchd/distiller.plist.example; this is documentary.
cron = "0 4 * * *"
# model = "claude-sonnet-4-6"   # optional override (reserved; unused today)

[skill_learner]
# ADR-017: the skill-gap learner. On-the-fly arm reviews a conversation after
# this many turns per chat; periodic arm proposes missing skills + curates.
nudge_interval = 12
cron = "30 4 * * *"          # periodic `learn` (informational; truth in the plist)
stale_after_days = 30        # agent-created skills idle this long → stale
archive_after_days = 90      # …this long → auto-archived (never deleted)
enabled = true

[gmail]
# Daily inbox metabolism (ADR-007). 5am local; cron evaluated in NUCLEUS_TZ.
metabolism_cron = "0 5 * * *"
# Cheap classifier — taxonomy is small and the rubric is fixed.
classifier_model = "claude-haiku-4-5"
# Auto-promote a sender to the kill-list after this many junk hits.
killlist_auto_promote_threshold = 3
# Default duration applied to calendar events scheduled via the
# `--channel calendar` reminder path when no explicit end time is given.
calendar_default_duration_min = 30

[reminders]
# Default output routing for system-prompt reminders (ADR-008) when
# neither the stored prompt nor --channels specifies where results
# should go. Body-based reminders aren't affected — they always use
# their own per-reminder channels.
default_channels = ["discord-home"]

[ports]
# Single operator app per ADR-015. Serves dashboard widgets, chat,
# the public news API, and every admin surface from one origin.
# Public news routes at /news/api/* stay through cloudflared; the
# rest gates behind Tailscale per ADR-011.
nucleus_dashboard = 8092
# Bonsai image-generation FastAPI backend (loopback only). The /gallery surface
# proxies generation requests here (ADR-019). Set NUCLEUS_BONSAI_DIR in .env.
bonsai = 8093

# ADR-023 session-search maintenance (distiller daily pass). prune_apply
# arms real deletion of junk transcripts (no substantive exchange, older
# than prune_max_age_days); false = dry-run reporting only. Flip to true
# after a week of clean dry-run counts in the distiller diary.
[session_search]
prune_apply = false
prune_max_age_days = 14

# ADR-035 vault search (`nucleus vault-search`, the dashboard search box).
# `exclude` ADDS vault-relative globs to a built-in floor that cannot be
# removed: dot folders, credential-like names (*password*, *senha*,
# *credential*, *secret*, *api-key*, *.pem, *.key) and any `homelab` folder.
# A pattern without `/` matches any single path component. Excluded notes
# are never indexed, returned, reported by vault-check, modified, or opened
# or listed by the dashboard. Changes apply at the next search or request,
# without a restart.
# Credentials reach the operator only through the authenticated DM, never
# through a search result.
[vault_search]
exclude = ["**/attachments/**", "**/_attachments/**", "**/assets/**"]
# Notes that hold a secret are excluded wherever they live. A built-in
# detector (always on) catches `password: x`, `- **Senha:** x`,
# `API_KEY=x`, a key written under a label such as `API key on file:`,
# well-known key formats and PEM private keys. This optional regex
# (case-insensitive, multi-line) adds your own patterns on top.
credential_content_regex = ""
# Dashboard search updates the index before it searches. Concurrent searches
# share one update; the update is skipped when the last one started less than
# this many seconds ago and no note changed since.
dashboard_reindex_fresh_secs = 30
# A search waits at most this long for the update, then answers 503 (the
# update keeps running and the next search uses it).
dashboard_reindex_wait_secs = 20

# ADR-035 weekly vault check (`nucleus vault-check`). launchd wakes the job
# hourly (tools/launchd/vault-check.plist.example); it runs when this cron
# has matched since the last scheduled run (5 fields, NUCLEUS_TZ).
[vault_check]
cron = "0 20 * * 0"                 # Sunday 20:00
inbox_max_age_days = 14
required_frontmatter = ["created", "source"]   # CLAUDE.md Rule 9.7
# Allowed `source:` values. `x*` is a prefix; `a+b` passes when each part does.
# Add your own writers (skills, imports) here.
source_vocabulary = [
  "whatsapp-braindump", "alfred-braindump", "chat-braindump",
  "distiller-contemplation", "obsidian-chat", "whatsapp-docstore",
  "whatsapp-chat", "nucleus-chat*", "nucleus-session", "claude-code*",
  "claude-session*", "voice-dictation", "deep-research", "research",
  "manual", "import",
]
# Never reported as orphans: hubs, journals, the inbox, the archive, and
# `_`-prefixed pipeline files.
orphan_exempt = ["README.md", "index.md", "Home.md", "_*", "0-Inbox/**", "1-Main-Notes/**", "2-Daily-Notes/**", "7-Archives/**"]
# Never reported for frontmatter or source.
frontmatter_exempt = ["README.md", "Home.md"]
# Scheduled runs: apply the safe fix (move empty `Untitled*` files that
# nothing links to into memory/vault-quarantine/). The check never rewrites
# a note; a missing `created` is only reported.
# Leave false until a few weekly reports look right. Manual runs use --apply.
scheduled_apply = false
# Scheduled runs: enqueue the one-line summary to the operator's WhatsApp DM.
notify = true

# ADR-033 WhatsApp turn engine. Every value is optional.
# ack_after_secs: an operator message without an answer this long gets one
#   code-sent acknowledgement ([whatsapp.texts] ack).
# progress_interval_secs: at most one progress message per turn per interval,
#   only when the model wrote new intermediate text; cut to progress_max_chars.
#   The outbound secret filter withholds a progress message that names a
#   secret or an identifier.
# turn_ceiling_hours: a turn running longer is interrupted and reported.
# permission_stall_secs: a turn stuck on an on-screen confirmation this long
#   is reported once.
[whatsapp.turns]
ack_after_secs = 30
progress_interval_secs = 180
progress_max_chars = 160
turn_ceiling_hours = 6
permission_stall_secs = 120

# ADR-033 fixed texts the WhatsApp bot sends (English by default). Every key
# is optional; the full list and the defaults are in
# messaging/whatsapp/src/texts.ts (keys in snake_case here). Placeholders in
# braces are filled by the bot.
[whatsapp.texts]
# ack = "⏳ Working on it…"
# progress_prefix = "↻ Progress: "
# interrupted = "⚠️ Interrupted: the bot restarted before the reply. Not resumed — send it again if you still want it."
# ceiling = "⚠️ This reply passed the {hours} h safety limit; I interrupted the session."

# [whatsapp.texts.infra_reasons]
# usage_limit = "the account reached its usage limit"

# ADR-033 background task workers (`nucleus tasks`). Internal safety limits:
# a task past max_concurrent waits queued for a slot; a worker past
# max_runtime_hours (counted from the moment it takes a slot) is stopped and
# marked failed. Both are logged when hit.
[tasks]
max_concurrent = 6
max_runtime_hours = 12
# tmux session hosting the worker windows (change only to isolate a test run)
# tmux_session = "nucleus-tasks"

# Status line of a finished task's result message, per final status. Goes to
# the task's origin (WhatsApp or Discord). {id} = short task id, {title}.
[tasks.texts]
# done = "✅ Task {id} done — {title}"
# failed = "⚠️ Task {id} failed — {title}"
# cancelled = "⏹ Task {id} cancelled — {title}"
# interrupted = "⚠️ Task {id} interrupted — {title}"
# Sent once when a result's delivery is given up (outcome unknown, or too many
# failures); the result is not sent again. {reason} = the recorded reason.
# delivery_failed = "⚠️ Task {id} — {title}: the result message was not confirmed as delivered ({reason}). …"

# ADR-027 WhatsApp connection circuit breaker. Defaults are sane; every
# value is optional. ladder_ms = reconnect backoff per consecutive quick
# failure; open_threshold failures within window_ms open the circuit
# (stop reconnecting, alert once on discord-home, probe every probe_ms).
# [whatsapp.breaker]
# ladder_ms = [1000, 2000, 5000, 15000, 60000, 300000]
# stable_ms = 120000
# open_threshold = 10
# window_ms = 900000
# probe_ms = 300000
# alert_after_outage_ms = 1800000

# ADR-034 usage accounting (`nucleus usage refresh`, dashboard /usage). Every
# value is optional; the defaults read the standard transcript locations.
# Dollar figures are estimates at API prices, not billing. The built-in price
# table (core/src/usage/pricing.rs) lists every model seen in Claude Code and
# Codex logs with its basis (API list price or third-party estimate), source
# URL and the date it was read; add or override a model here in USD per
# million tokens, keyed by model id or id prefix. A model with no price is
# shown on the page as "tokens without a price", never as $0.
# [usage]
# claude_projects_dir = "~/.claude/projects"
# codex_sessions_dir = "~/.codex/sessions"
# worktree_markers = ["/.claude/worktrees/", "/.worktrees/"]
# [usage.prices."some-new-model"]
# input = 3.0
# output = 15.0
# cache_read = 0.3
# cache_write_5m = 3.75
# cache_write_1h = 6.0
# Optional whole-request rates above a prompt size (OpenAI long context):
# [usage.prices."some-new-model".long_context]
# above_input_tokens = 272000
# input = 6.0
# output = 22.5
# cache_read = 0.6
# cache_write = 7.5
